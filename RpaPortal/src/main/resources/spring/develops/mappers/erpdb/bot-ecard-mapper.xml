<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kcc.biz.dao.BotEcardRepository">
	
	<insert id="createBotEcardRequestDate" statementType="CALLABLE" parameterType="botEcardVO">
		<![CDATA[
			{ 
	            call PRA_Bot_createBotEcardRequestDate (
					#{RequestNo}
	            	,#{SiteCd}
	            	,#{EmpNo}
            	)
			}
		]]>
	</insert>
	
	<select id="listBotEcardTargetDate" statementType="CALLABLE" parameterType="botEcardVO" resultType="botEcardVO">
		<![CDATA[
			{ 
	            call PRA_Bot_listBotEcardTargetDate (
            		#{RequestNo}
            	)
			}
		]]>
	</select>
	
</mapper>